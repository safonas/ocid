[Unit]
Description=ocid — local-first, peer-to-peer OCI image distribution
Documentation=https://github.com/safonas/ocid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ocid
Environment=OCID_HOME=/var/lib/ocid
Environment=OCID_LISTEN=127.0.0.1:5050
Environment=RUST_LOG=ocid=info,warn
Restart=on-failure
RestartSec=5

# Run as an ephemeral UID; state lives in /var/lib/ocid.
DynamicUser=yes
StateDirectory=ocid

# Hardening (unprivileged loopback service, needs UDP/TCP egress for p2p).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
