{
  "name": "ocid",
  "displayName": "ocid",
  "description": "Peer-to-peer OCI image sharing: seed, follow and pull images from teammates over QUIC — no registry, no accounts.",
  "version": "0.6.2",
  "icon": "icon.png",
  "publisher": "safonas",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/safonas/ocid",
  "homepage": "https://github.com/safonas/ocid#readme",
  "engines": {
    "podman-desktop": ">=1.22.0"
  },
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "vite build",
    "build:frontend": "cd frontend && vite build",
    "typecheck": "tsc --noEmit && cd frontend && svelte-check --tsconfig tsconfig.json --tsgo"
  },
  "contributes": {
    "configuration": {
      "title": "ocid",
      "properties": {
        "ocid.registryUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5050",
          "description": "Base URL of the ocid daemon's registry and control API."
        }
      }
    },
    "commands": [
      {
        "command": "ocid.openDashboard",
        "title": "ocid: Open dashboard"
      },
      {
        "command": "ocid.image.push",
        "title": "ocid: Push image to peers"
      }
    ],
    "menus": {
      "dashboard/image": [
        {
          "command": "ocid.image.push",
          "title": "Push image to ocid peers"
        }
      ]
    }
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@podman-desktop/api": "^1.29.1",
    "@podman-desktop/ui-svelte": "^1.29.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@typescript/native": "npm:typescript@~7.0.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.0",
    "vite": "^8.3.0"
  }
}
