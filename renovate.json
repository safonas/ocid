{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned container images in justfiles and workflows",
      "managerFilePatterns": [
        "/^justfile$/",
        "/\\.just$/",
        "/^\\.github\\/workflows\\/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "\"(?<depName>[a-z0-9.-]+(?:/[a-z0-9._-]+)+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo minor and patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions minor and patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["slsa-framework/slsa-github-generator"],
      "description": "The SLSA generator must be called by tag ref (it resolves its verified builder binary by tag); SHA pinning breaks it. See upstream RENOVATE.md.",
      "pinDigests": false
    }
  ]
}
