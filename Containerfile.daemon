# Daemon image assembled from the *prebuilt* release binary — used by the
# extension workflow, which embeds it in the Podman Desktop extension
# instead of compiling the daemon a second time (glibc is
# backward-compatible, so the runner-built binary runs on Wolfi's rolling
# base; if the runner ever moves past Wolfi's glibc, this breaks loudly).
#
# Same image as ./Containerfile's `daemon` stage (built from source for
# local dev via `just ext daemon-image`); keep the two in sync. Only `ocid`
# — the artifact stays lean, and host-side ocictl manages the pod daemon
# over https.

# syntax=docker/dockerfile:1.27@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

# Wolfi rolling base (re-pin regularly for fresh security fixes).
ARG RUNTIME_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:7d567cad5eab29038705b01a900061fdae87ff19d23ae2b44c93ce691608c0ac

FROM ${RUNTIME_IMAGE}

RUN apk add --no-cache ca-certificates \
  && addgroup -S -g 1000 ocid \
  && adduser -S -D -u 1000 -G ocid -h /data ocid

COPY dist/daemon-bin/ocid /usr/local/bin/ocid

USER ocid
WORKDIR /data
ENV OCID_HOME=/data
# Inside a container the registry must bind all interfaces to be reachable via -p.
ENV OCID_LISTEN=0.0.0.0:5050
VOLUME ["/data"]

# 5050: local OCI registry + control API + /metrics
EXPOSE 5050/tcp

# The daemon initialises an identity on first start if /data is empty.
ENTRYPOINT ["/usr/local/bin/ocid"]
